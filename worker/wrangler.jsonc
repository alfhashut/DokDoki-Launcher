{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "dokdoki-requests",
  "main": "src/index.js",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,

  "vars": {
    "SUBMISSIONS_ENABLED": "true",
    "ALLOWED_ORIGINS": "https://alfhashut.github.io"
  },

  "secrets": {
    "required": [
      "GITHUB_TOKEN",
      "TURNSTILE_SECRET_KEY"
    ]
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
